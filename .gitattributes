# Files that run on Linux keep LF, even in a Windows checkout: a CRLF shell script, udev
# rule or unit file breaks once it is copied to the box.
*.sh text eol=lf
*.rules text eol=lf
*.service text eol=lf
packaging/** text eol=lf
# Firmware sources and tools are LF everywhere; the release images and test fixtures are
# binary.
firmware/** text eol=lf
firmware/**/*.bin binary
firmware/**/*.uf2 binary
# The Rust backend (sources, board files, fixtures) is LF everywhere, like firmware/.
backend/** text eol=lf
# The web UI (web/) is LF everywhere, like the rest of the code the box runs.
web/** text eol=lf
