# Files that run on Linux keep LF, even in a Windows checkout: a CRLF shell script, udev
# rule or unit file breaks once it is copied to the box.
*.sh text eol=lf
*.rules text eol=lf
*.service text eol=lf
packaging/** text eol=lf
# Test fixtures are captures from a Linux box and the tests compare them byte for byte:
# CRLF in a Windows checkout made 19 tests fail there.
peripherals/**/*-fixtures/** text eol=lf
