# Files that run on Linux keep LF, even in a Windows checkout: a CRLF shell script, udev
# rule or unit file breaks once it is copied to the box.
*.sh text eol=lf
*.rules text eol=lf
*.service text eol=lf
packaging/** text eol=lf
# Firmware sources and tools are LF everywhere; the release images and test fixtures are
# binary.
firmware/** text eol=lf
firmware/**/*.bin binary
firmware/**/*.uf2 binary
