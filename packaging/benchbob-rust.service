[Unit]
Description=BenchBob bench server (Rust; unported panels proxied to the Bun server)
Documentation=https://github.com/cinderblock/BenchBob/tree/master/backend
After=network-online.target nfs-server.service nbd-server.service benchbob.service
Wants=network-online.target benchbob.service

# Rust mode, off by default. `sudo benchbob-setup rust on` enables this unit, which takes
# port 80, and moves benchbob.service (Bun) to port 8081 without the drivers this server
# runs itself; this server proxies everything else to it on 127.0.0.1. (Bun still listens
# on every interface there: it has no bind-address setting.) `sudo benchbob-setup rust
# off` undoes both.

[Service]
Type=simple
User=benchbob
Group=benchbob
WorkingDirectory=/usr/lib/benchbob
ExecStart=/usr/lib/benchbob/bin/benchbob
Environment=BENCHBOB_LEGACY_PORT=8081
# PORT, BENCHBOB_PORT_OFFSET and the like (they apply to this server in Rust mode).
EnvironmentFile=-/etc/default/benchbob
Environment=HOME=/var/lib/benchbob
Environment=PATH=/usr/lib/benchbob/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The same settings directory as the Bun server (peripherals.json is shared, merged on write).
StateDirectory=benchbob
StateDirectoryMode=0750
# Port 80 without root; privileged work goes through sudo, so NoNewPrivileges= stays off.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
