[Unit]
Description=BenchBob bench server
Documentation=https://github.com/cinderblock/BenchBob
After=network-online.target nfs-server.service nbd-server.service
Wants=network-online.target

[Service]
Type=simple
User=benchbob
Group=benchbob
WorkingDirectory=/usr/lib/benchbob
ExecStart=/usr/lib/benchbob/bin/benchbob
# PORT, BENCHBOB_PORT_OFFSET and the like.
EnvironmentFile=-/etc/default/benchbob
Environment=HOME=/var/lib/benchbob
Environment=PATH=/usr/lib/benchbob/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Settings and saved lists ($STATE_DIRECTORY).
StateDirectory=benchbob
StateDirectoryMode=0750
# Scratch space that may be thrown away; postinst empties it on every upgrade.
CacheDirectory=benchbob
# The dashboard listens on port 80 without running as root. Privileged work goes through
# sudo (see /etc/sudoers.d/benchbob), so NoNewPrivileges= must stay off.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
