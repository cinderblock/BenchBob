{
  "name": "benchbob-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode mcu && bun scripts/size.ts",
    "build:full": "vite build",
    "build:mcu": "vite build --mode mcu",
    "size": "bun scripts/size.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
